# Cookies & Auth (sensitive!)
cookies.txt
dist/cookies.txt
*.cookies
yt_auth_cookies.json

# yt-dlp Engine Updates (stored in AppData at runtime)
engine_updates/

# Binary Assets (large, rebuilt by build_exe.py)
ffmpeg.exe
app.ico

# Logs
*.log
logs/

# IDE & OS
.vscode/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db
desktop.ini
